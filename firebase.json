{
  "functions": {
    "source": ".",
    "codebase": "default",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "**/.*",
      "**/node_modules/**",
      "index.html",
      "css/**",
      "js/**",
      "README.md",
      "firestore.rules",
      "firebase-messaging-sw.js"
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "**/.*",
      "**/node_modules/**",
      "test/**",
      "index.js",
      "test-access-index.js",
      "package.json",
      "package-lock.json",
      "README.md",
      "firestore.rules"
    ]
  },
  "emulators": {
    "firestore": {
      "port": 8080
    },
    "ui": {
      "enabled": false
    }
  }
}
