rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model & Security Invariants
    // ===============================================================
    //
    // 1. account_access/{uid}
    //    - Trusted authority & RBAC record keyed by Firebase Auth UID.
    //    - Fields: uid (string), username (string), role ('student' | 'teacher'),
    //      paid (bool), billingExpiresAt (timestamp | null).
    //
    // 2. users/{username}
    //    - User profile document keyed by username.
    //    - Self-registration create allowed only for student role with unpaid status
    //      and strict key whitelist:
    //      ['user', 'uid', 'email', 'role', 'status', 'isPaid', 'paymentStatus', 'createdAt'].
    //    - Student self-update strictly whitelisted to non-privileged profile,
    //      study goal, gamification, and pending payment notification fields.
    //    - Admin/teacher financial & privilege fields (role, isPaid, status, disabled,
    //      billingExpiresAt, billingAccessOverride, totalLessonsPaid, referralDiscountCredits,
    //      paymentHistory, etc.) are immutable for students.
    //
    // 3. settings/{documentId}
    //    - public_profile, billing, availability, templates, and admin settings.
    //
    // 4. packages/{packageId}, course_catalog/{classId}, hall_of_fame/{entryId}
    //    - Public storefront data; write/delete restricted to staff (admin/teacher).
    //
    // 5. tests/{testId}, classes/{classId}, schedules/{scheduleId}, attendance/{attendanceId}
    //    - Core LMS curriculum and scheduling collections; write/delete restricted to staff.
    //
    // 6. classes/{classId}/messages/{messageId}, public_messages/{messageId}, messages/{messageId}
    //    - Course forum & discussion messages; student create/update validated for
    //      ownership, schema, and size limits; delete restricted to staff.
    //
    // 7. class_presence/{presenceId}
    //    - Real-time student online presence per class; delete restricted to staff.
    //
    // 8. submissions/{submissionId}
    //    - Test submissions; student create requires matching submissionId, active test
    //      assignment, and valid schema; student update restricted to studentReply;
    //      delete restricted to staff.
    //
    // 9. student_test_access/{uid}/tests/{testId}
    //    - Student-synced index of assigned tests verified against class/schedule documents.
    //
    // 10. notes/{noteId}, flashcards/{deckId}
    //     - Student study notes and flashcard decks scoped by username prefix and owner field;
    //       delete restricted to staff.
    //
    // 11. referral_codes/{code}
    //     - Student referral code mapping { user, code }; ownership enforced on create/update
    //       to prevent IDOR overwrite; delete restricted to staff.
    //
    // 12. game_leaderboards/{recordId}
    //     - Study game records { id, student, listId, time, date }; create-only for paid
    //       students; update and delete restricted to staff.
    // ===============================================================

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email == 'lyquockhanh03@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function accessPath(uid) {
      return /databases/$(database)/documents/account_access/$(uid);
    }

    function classPath(classId) {
      return /databases/$(database)/documents/classes/$(classId);
    }

    function schedulePath(scheduleId) {
      return /databases/$(database)/documents/schedules/$(scheduleId);
    }

    function studentTestAccessPath(uid, testId) {
      return /databases/$(database)/documents/student_test_access/$(uid)/tests/$(testId);
    }

    function hasAccessRecord() {
      return signedIn() && exists(accessPath(request.auth.uid));
    }

    function accountAccess() {
      return get(accessPath(request.auth.uid)).data;
    }

    function isStaff() {
      return isAdmin()
        || (hasAccessRecord() && accountAccess().role == 'teacher');
    }

    function hasPaidAccess() {
      return isStaff()
        || (hasAccessRecord()
          && accountAccess().role == 'student'
          && accountAccess().paid == true
          && (!('billingExpiresAt' in accountAccess())
            || accountAccess().billingExpiresAt == null
            || accountAccess().billingExpiresAt > request.time));
    }

    function isValidOptionalString(data, field, maxLen) {
      return !(field in data)
        || data[field] == null
        || (data[field] is string && data[field].size() <= maxLen);
    }

    function isClassMember(classId, username) {
      return classId is string
        && exists(classPath(classId))
        && get(classPath(classId)).data.get('enrolledStudents', []).hasAny([username]);
    }

    function classHasTest(classId, testId) {
      let cls = get(classPath(classId)).data;
      let parentId = cls.get('parentClassId', null);
      return (cls.get('assignedTests', []).hasAny([testId])
          || testId in cls.get('testSettings', {}).keys())
        || (parentId is string
          && exists(classPath(parentId))
          && (get(classPath(parentId)).data.get('assignedTests', []).hasAny([testId])
            || testId in get(classPath(parentId)).data.get('testSettings', {}).keys()));
    }

    function scheduleHasTest(scheduleId, classId, username, testId) {
      return exists(schedulePath(scheduleId))
        && get(schedulePath(scheduleId)).data.get('classId', null) == classId
        && (
          get(schedulePath(scheduleId)).data.get('assignedTests', []).hasAny([testId])
          || get(schedulePath(scheduleId)).data.get('materialIds', []).hasAny([testId])
          || get(schedulePath(scheduleId)).data.get('homeworkTests', []).hasAny([testId])
        )
        && (!('attendingStudents' in get(schedulePath(scheduleId)).data)
          || get(schedulePath(scheduleId)).data.attendingStudents.hasAny([username]));
    }

    function validStudentTestAccess(uid, testId) {
      let data = request.resource.data;
      let classId = data.get('classId', null);
      let username = accountAccess().username;
      return hasPaidAccess()
        && request.auth.uid == uid
        && data.get('uid', null) == uid
        && data.get('username', null) == username
        && data.get('testId', null) == testId
        && isClassMember(classId, username)
        && (
          (data.get('source', null) == 'class'
            && data.keys().hasOnly(['uid', 'username', 'testId', 'classId', 'source'])
            && classHasTest(classId, testId))
          || (data.get('source', null) == 'schedule'
            && data.keys().hasOnly(['uid', 'username', 'testId', 'classId', 'scheduleId', 'source'])
            && data.get('scheduleId', null) is string
            && scheduleHasTest(data.scheduleId, classId, username, testId))
        );
    }

    function hasTestAssignmentForClass(classId, username, testId, scheduleId) {
      return isClassMember(classId, username)
        && (classHasTest(classId, testId)
          || (scheduleId is string
            && scheduleHasTest(scheduleId, classId, username, testId)));
    }

    function hasCurrentTestAssignment(testId) {
      let path = studentTestAccessPath(request.auth.uid, testId);
      let access = get(path).data;
      return hasPaidAccess()
        && exists(path)
        && access.get('uid', null) == request.auth.uid
        && access.get('username', null) == accountAccess().username
        && isClassMember(access.get('classId', null), accountAccess().username)
        && (
          (access.get('source', null) == 'class'
            && classHasTest(access.classId, testId))
          || (access.get('source', null) == 'schedule'
            && scheduleHasTest(access.get('scheduleId', ''), access.classId, access.username, testId))
        );
    }

    function safeStudentMessageCreate() {
      let data = request.resource.data;
      return data.get('author', null) == accountAccess().username
        && data.get('role', null) == accountAccess().role
        && data.keys().hasOnly([
          'id', 'kind', 'parentId', 'threadId', 'title', 'text',
          'author', 'avatar', 'role', 'timestamp', 'classId'
        ])
        && data.get('text', null) is string
        && data.text.size() > 0
        && data.text.size() <= 10000
        && isValidOptionalString(data, 'id', 120)
        && isValidOptionalString(data, 'kind', 40)
        && isValidOptionalString(data, 'parentId', 120)
        && isValidOptionalString(data, 'threadId', 120)
        && isValidOptionalString(data, 'title', 300)
        && isValidOptionalString(data, 'avatar', 2048)
        && isValidOptionalString(data, 'classId', 120)
        && (!('timestamp' in data) || data.timestamp is number);
    }

    function safeStudentPublicMessageCreate() {
      return safeStudentMessageCreate()
        && request.resource.data.get('classId', null) == null;
    }

    function safeStudentSubmissionUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly(['studentReply', 'teacherReadReply'])
        && isValidOptionalString(request.resource.data, 'studentReply', 5000)
        && (!changed.hasAny(['teacherReadReply'])
          || (request.resource.data.teacherReadReply == false
            && changed.hasAny(['studentReply'])));
    }

    function safeStudentSubmissionCreate(submissionId) {
      let data = request.resource.data;
      return (data.id is string || data.id is int)
        && string(data.id) == submissionId
        && data.student == accountAccess().username
        && data.testId is string
        && data.testId.size() <= 120
        && hasCurrentTestAssignment(data.testId)
        && data.classId is string
        && data.classId.size() <= 120
        && hasTestAssignmentForClass(
          data.classId,
          accountAccess().username,
          data.testId,
          data.get('scheduleId', null)
        )
        && data.className == get(classPath(data.classId)).data.name
        && isValidOptionalString(data, 'testName', 300)
        && isValidOptionalString(data, 'scheduleId', 120)
        && isValidOptionalString(data, 'date', 60)
        && isValidOptionalString(data, 'score', 120)
        && data.keys().hasOnly([
          'id', 'student', 'testId', 'testName', 'classId', 'className', 'scheduleId', 'date',
          'answers', 'score', 'syntheticData', 'questionAnalytics', 'secureInfractions'
        ]);
    }

    function safeStudentMessageUpdate() {
      let data = request.resource.data;
      return data.diff(resource.data).affectedKeys()
          .hasOnly(['title', 'text', 'editedAt', 'editedBy'])
        && data.get('author', null) == resource.data.get('author', null)
        && data.get('classId', null) == resource.data.get('classId', null)
        && data.get('parentId', null) == resource.data.get('parentId', null)
        && data.get('threadId', null) == resource.data.get('threadId', null)
        && data.get('kind', null) == resource.data.get('kind', null)
        && data.get('text', null) is string
        && data.text.size() > 0
        && data.text.size() <= 10000
        && isValidOptionalString(data, 'title', 300)
        && isValidOptionalString(data, 'editedBy', 80)
        && (!('editedAt' in data) || data.editedAt == null || data.editedAt is number);
    }

    function ownAccount(username) {
      return signedIn()
        && resource.data.user == username
        && (resource.data.get('uid', null) == request.auth.uid
          || (resource.data.get('uid', null) == null
            && hasAccessRecord()
            && accountAccess().username == username));
    }

    function safeStudentSelfRegistrationCreate(username) {
      let data = request.resource.data;
      return signedIn()
        && !('pass' in data)
        && data.keys().hasOnly([
          'user', 'uid', 'email', 'role', 'status', 'isPaid', 'paymentStatus', 'createdAt'
        ])
        && data.uid == request.auth.uid
        && data.user == username
        && username.matches('^[A-Za-z0-9_-]{1,40}$')
        && data.role == 'student'
        && data.isPaid == false
        && data.paymentStatus == 'unpaid'
        && data.status == 'unpaid'
        && isValidOptionalString(data, 'email', 254)
        && isValidOptionalString(data, 'createdAt', 64);
    }

    function safeStudentProfileUpdate() {
      let data = request.resource.data;
      let changed = data.diff(resource.data).affectedKeys();
      return !('pass' in data)
        && changed.hasOnly([
          'email', 'lastLoginAt', 'referralCode', 'appliedReferralCode', 'appliedReferralBy',
          'pendingRenewal', 'paymentStatus', 'pendingInfo', 'pendingLessons', 'pendingAmount',
          'pendingPlanTitle', 'pendingPlanMonths', 'pendingPaymentId', 'pendingReferralCreditsUsed',
          'pendingReferralBy', 'pendingReferralCode', 'pendingClasses', 'gems', 'inventory',
          'equipped', 'unlockedTests', 'targetScore', 'testDate', 'avatar', 'currentStreak',
          'lastLoginDate', 'fcmToken', 'realName', 'phone', 'taxPayerName', 'taxId', 'taxAddress',
          'pendingTaxPayerName', 'pendingTaxPayerPhone', 'pendingTaxId', 'pendingTaxAddress',
          'pendingTaxInvoiceRequested', 'pendingPaymentMethod', 'pendingSubmittedAt'
        ])
        && data.get('uid', null) == resource.data.get('uid', null)
        && data.get('user', null) == resource.data.get('user', null)
        && data.get('role', null) == resource.data.get('role', null)
        && data.get('isPaid', null) == resource.data.get('isPaid', null)
        && data.get('status', null) == resource.data.get('status', null)
        && data.get('disabled', null) == resource.data.get('disabled', null)
        && data.get('billingExpiresAt', null) == resource.data.get('billingExpiresAt', null)
        && data.get('billingAccessOverride', null) == resource.data.get('billingAccessOverride', null)
        && (!changed.hasAny(['paymentStatus'])
          || data.paymentStatus in ['unpaid', 'pending'])
        && (!changed.hasAny(['gems'])
          || (data.gems is int
            && data.gems >= 0
            && data.gems <= resource.data.get('gems', 0) + 150))
        && isValidOptionalString(data, 'email', 254)
        && isValidOptionalString(data, 'lastLoginAt', 64)
        && isValidOptionalString(data, 'referralCode', 40)
        && isValidOptionalString(data, 'appliedReferralCode', 40)
        && isValidOptionalString(data, 'appliedReferralBy', 40)
        && isValidOptionalString(data, 'pendingInfo', 500)
        && isValidOptionalString(data, 'pendingPlanTitle', 200)
        && isValidOptionalString(data, 'pendingPaymentId', 120)
        && isValidOptionalString(data, 'pendingReferralBy', 40)
        && isValidOptionalString(data, 'pendingReferralCode', 40)
        && isValidOptionalString(data, 'targetScore', 20)
        && isValidOptionalString(data, 'testDate', 40)
        && isValidOptionalString(data, 'avatar', 2048)
        && isValidOptionalString(data, 'lastLoginDate', 40)
        && isValidOptionalString(data, 'fcmToken', 1024)
        && isValidOptionalString(data, 'realName', 150)
        && isValidOptionalString(data, 'phone', 40)
        && isValidOptionalString(data, 'taxPayerName', 150)
        && isValidOptionalString(data, 'taxId', 40)
        && isValidOptionalString(data, 'taxAddress', 300)
        && isValidOptionalString(data, 'pendingTaxPayerName', 150)
        && isValidOptionalString(data, 'pendingTaxPayerPhone', 40)
        && isValidOptionalString(data, 'pendingTaxId', 40)
        && isValidOptionalString(data, 'pendingTaxAddress', 300)
        && isValidOptionalString(data, 'pendingPaymentMethod', 60)
        && (!('pendingClasses' in data) || data.pendingClasses == null || (data.pendingClasses is list && data.pendingClasses.size() <= 50))
        && (!('inventory' in data) || data.inventory == null || (data.inventory is list && data.inventory.size() <= 200))
        && (!('unlockedTests' in data) || data.unlockedTests == null || (data.unlockedTests is list && data.unlockedTests.size() <= 500))
        && (!('equipped' in data) || data.equipped == null || (data.equipped is map && data.equipped.size() <= 50))
        && (!('pendingRenewal' in data) || data.pendingRenewal == null || data.pendingRenewal is bool)
        && (!('pendingTaxInvoiceRequested' in data) || data.pendingTaxInvoiceRequested == null || data.pendingTaxInvoiceRequested is bool)
        && (!('pendingLessons' in data) || data.pendingLessons == null || (data.pendingLessons is number && data.pendingLessons >= 0))
        && (!('pendingAmount' in data) || data.pendingAmount == null || (data.pendingAmount is number && data.pendingAmount >= 0))
        && (!('pendingPlanMonths' in data) || data.pendingPlanMonths == null || (data.pendingPlanMonths is number && data.pendingPlanMonths >= 0))
        && (!('pendingReferralCreditsUsed' in data) || data.pendingReferralCreditsUsed == null || (data.pendingReferralCreditsUsed is number && data.pendingReferralCreditsUsed >= 0))
        && (!('pendingSubmittedAt' in data) || data.pendingSubmittedAt == null || (data.pendingSubmittedAt is number && data.pendingSubmittedAt >= 0))
        && (!('currentStreak' in data) || data.currentStreak == null || (data.currentStreak is int && data.currentStreak >= 0 && data.currentStreak <= 10000));
    }

    function safeLegacyProfileMigration(username) {
      return signedIn()
        && resource.data.get('uid', null) == null
        && resource.data.user == username
        && hasAccessRecord()
        && accountAccess().username == username
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.user == username
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid', 'pass']);
    }

    function validStudentPresenceWrite() {
      let data = request.resource.data;
      return data.keys().hasOnly(['classId', 'student', 'isOnline', 'lastActiveAt'])
        && data.student == accountAccess().username
        && data.classId is string
        && data.classId.size() <= 120
        && data.isOnline is bool
        && data.lastActiveAt is number
        && isClassMember(data.classId, accountAccess().username);
    }

    function validStudentStudyDocWrite(docId) {
      let data = request.resource.data;
      return docId.size() <= 150
        && docId.matches('^' + accountAccess().username + '(_.*)?$')
        && data.keys().hasOnly(['owner', 'data'])
        && data.owner == accountAccess().username
        && data.data is list
        && data.data.size() <= 1000;
    }

    match /account_access/{uid} {
      allow get: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow list: if isStaff();
      allow create: if isAdmin()
        || (signedIn()
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['uid', 'username', 'role', 'paid'])
          && request.resource.data.uid == uid
          && request.resource.data.role == 'student'
          && request.resource.data.paid == false
          && request.resource.data.username.matches('^[A-Za-z0-9_-]{1,40}$')
          && getAfter(/databases/$(database)/documents/users/$(request.resource.data.username)).data.uid == uid);
      allow update, delete: if isAdmin();
    }

    match /users/{username} {
      allow get: if isAdmin() || ownAccount(username);
      allow list: if isStaff()
        || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if !('pass' in request.resource.data)
        && (isAdmin() || safeStudentSelfRegistrationCreate(username));
      allow update: if !('pass' in request.resource.data)
        && (isAdmin()
          || (ownAccount(username) && safeStudentProfileUpdate())
          || safeLegacyProfileMigration(username));
      allow delete: if isAdmin();
    }

    match /settings/public_profile {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /settings/billing {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /settings/availability {
      allow read: if hasPaidAccess();
      allow create, update, delete: if isStaff();
    }

    match /settings/templates {
      allow read: if signedIn();
      allow create, update, delete: if isStaff();
    }

    match /settings/{documentId} {
      allow read: if isStaff();
      allow create, update, delete: if isAdmin();
    }

    match /packages/{packageId} {
      allow read: if true;
      allow create, update, delete: if isStaff();
    }

    match /course_catalog/{classId} {
      allow read: if true;
      allow create, update, delete: if isStaff();
    }

    match /hall_of_fame/{entryId} {
      allow read: if true;
      allow create, update, delete: if isStaff();
    }

    match /tests/{testId} {
      allow get: if isStaff() || hasCurrentTestAssignment(testId);
      allow list: if isStaff();
      allow create, update, delete: if isStaff();
    }

    match /classes/{classId} {
      allow get, list: if isStaff()
        || (hasPaidAccess()
          && resource.data.get('enrolledStudents', []).hasAny([accountAccess().username]));
      allow create, update, delete: if isStaff();

      match /messages/{messageId} {
        allow get, list: if isStaff()
          || (hasPaidAccess() && isClassMember(classId, accountAccess().username));
        allow create: if isStaff()
          || (hasPaidAccess()
            && isClassMember(classId, accountAccess().username)
            && safeStudentMessageCreate()
            && request.resource.data.get('classId', classId) == classId);
        allow update: if isStaff()
          || (hasPaidAccess()
            && isClassMember(classId, accountAccess().username)
            && resource.data.get('author', null) == accountAccess().username
            && safeStudentMessageUpdate());
        allow delete: if isStaff();
      }
    }

    match /schedules/{scheduleId} {
      allow read: if isStaff()
        || (hasPaidAccess() && isClassMember(resource.data.get('classId', null), accountAccess().username));
      allow create, update, delete: if isStaff();
    }

    match /attendance/{attendanceId} {
      allow read: if isStaff()
        || (hasPaidAccess() && resource.data.student == accountAccess().username);
      allow create, update, delete: if isStaff();
    }

    match /class_presence/{presenceId} {
      allow read: if isStaff()
        || (hasPaidAccess() && isClassMember(resource.data.get('classId', null), accountAccess().username));
      allow create: if isStaff()
        || (hasPaidAccess() && validStudentPresenceWrite());
      allow update: if isStaff()
        || (hasPaidAccess()
          && resource.data.student == accountAccess().username
          && validStudentPresenceWrite()
          && request.resource.data.student == resource.data.student
          && request.resource.data.classId == resource.data.classId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isOnline', 'lastActiveAt']));
      allow delete: if isStaff();
    }

    match /submissions/{submissionId} {
      allow read: if isStaff()
        || (hasPaidAccess() && resource.data.student == accountAccess().username);
      allow create: if isStaff() || (hasPaidAccess() && safeStudentSubmissionCreate(submissionId));
      allow update: if isStaff()
        || (hasPaidAccess()
          && resource.data.student == accountAccess().username
          && request.resource.data.student == resource.data.student
          && safeStudentSubmissionUpdate());
      allow delete: if isStaff();
    }

    match /messages/{messageId} {
      allow read, create, update, delete: if isStaff();
    }

    match /public_messages/{messageId} {
      allow read: if hasPaidAccess();
      allow create: if isStaff()
        || (hasPaidAccess() && safeStudentPublicMessageCreate());
      allow update: if isStaff()
        || (hasPaidAccess()
          && resource.data.author == accountAccess().username
          && safeStudentMessageUpdate());
      allow delete: if isStaff();
    }

    match /student_test_access/{uid}/tests/{testId} {
      allow get, list: if isStaff() || (hasPaidAccess() && request.auth.uid == uid);
      allow create, update: if validStudentTestAccess(uid, testId);
      allow delete: if hasPaidAccess() && request.auth.uid == uid;
    }

    match /notes/{noteId} {
      allow get, list: if isStaff()
        || (hasPaidAccess() && resource.data.get('owner', null) == accountAccess().username);
      allow create: if isStaff()
        || (hasPaidAccess() && validStudentStudyDocWrite(noteId));
      allow update: if isStaff()
        || (hasPaidAccess()
          && validStudentStudyDocWrite(noteId)
          && resource.data.get('owner', null) == accountAccess().username
          && request.resource.data.owner == resource.data.owner);
      allow delete: if isStaff();
    }

    match /flashcards/{deckId} {
      allow get, list: if isStaff()
        || (hasPaidAccess() && resource.data.get('owner', null) == accountAccess().username);
      allow create: if isStaff()
        || (hasPaidAccess() && validStudentStudyDocWrite(deckId));
      allow update: if isStaff()
        || (hasPaidAccess()
          && validStudentStudyDocWrite(deckId)
          && resource.data.get('owner', null) == accountAccess().username
          && request.resource.data.owner == resource.data.owner);
      allow delete: if isStaff();
    }

    match /referral_codes/{code} {
      allow read: if signedIn();
      allow create: if isStaff()
        || (hasAccessRecord()
          && code.size() > 0
          && code.size() <= 40
          && request.resource.data.user == accountAccess().username
          && request.resource.data.code == code
          && request.resource.data.keys().hasOnly(['user', 'code']));
      allow update: if isStaff()
        || (hasAccessRecord()
          && code.size() > 0
          && code.size() <= 40
          && resource.data.user == accountAccess().username
          && request.resource.data.user == resource.data.user
          && request.resource.data.code == code
          && request.resource.data.keys().hasOnly(['user', 'code']));
      allow delete: if isStaff();
    }

    match /game_leaderboards/{recordId} {
      allow read: if hasPaidAccess();
      allow create: if isStaff()
        || (hasPaidAccess()
          && recordId.size() <= 120
          && request.resource.data.student == accountAccess().username
          && request.resource.data.id == recordId
          && request.resource.data.keys().hasOnly(['id', 'student', 'listId', 'time', 'date'])
          && request.resource.data.time is number
          && request.resource.data.time >= 0
          && request.resource.data.listId is string
          && request.resource.data.listId.size() <= 120
          && request.resource.data.date is number);
      allow update, delete: if isStaff();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
